. 
. * 9. DISTRIBUCIONES DESCRIPTIVAS. Todos los registros de los cuatro grupos.
. * El kernel gaussiano, el ancho y la rejilla son comunes a las cuatro curvas.
. * El ancho por defecto se calcula en TODA la muestra y despues se fija.
. * Los 400 puntos son evaluaciones de la densidad, no personas seleccionadas.
. * Las densidades son no ponderadas y sin controles; cada curva integra a uno.
. quietly kdensity ln_ing_hora_real2025, kernel(gaussian) n(400) generate(e8_grid e8_global) nograph

. local ancho = r(bwidth)

. assert `ancho' > 0 & !missing(`ancho')

. display "ANCHO COMUN PARA DENSIDADES: " %12.8f `ancho'
ANCHO COMUN PARA DENSIDADES:   0.08805486

. quietly kdensity ln_ing_hora_real2025 if informal == 0 & tic_uso_pc == 0, kernel(gaussian) bwidth(`ancho') at(e8_grid) generate(e8_f0)
>  nograph

. quietly kdensity ln_ing_hora_real2025 if informal == 0 & tic_uso_pc == 1, kernel(gaussian) bwidth(`ancho') at(e8_grid) generate(e8_f1)
>  nograph

. quietly kdensity ln_ing_hora_real2025 if informal == 1 & tic_uso_pc == 0, kernel(gaussian) bwidth(`ancho') at(e8_grid) generate(e8_i0)
>  nograph

. quietly kdensity ln_ing_hora_real2025 if informal == 1 & tic_uso_pc == 1, kernel(gaussian) bwidth(`ancho') at(e8_grid) generate(e8_i1)
>  nograph

. assert !missing(e8_f0, e8_f1, e8_i0, e8_i1) if !missing(e8_grid)

. generate double e8_ancho = `ancho'

. label variable e8_f0 "Formal no usuario"

. label variable e8_f1 "Formal usuario"

. label variable e8_i0 "Informal no usuario"

. label variable e8_i1 "Informal usuario"

. twoway (line e8_f0 e8_grid, sort lcolor(gs7)) (line e8_f1 e8_grid, sort lcolor(navy)), title("Empleo formal", size(medsmall)) xtitle("
> Log ingreso horario a precios de 2025", size(small)) ytitle("Densidad") legend(order(1 "No usa" 2 "Usa") rows(1) size(small)) graphreg
> ion(color(white)) plotregion(color(white)) name(e8_dens_formal, replace)

. twoway (line e8_i0 e8_grid, sort lcolor(gs7)) (line e8_i1 e8_grid, sort lcolor(navy)), title("Empleo informal", size(medsmall)) xtitle
> ("Log ingreso horario a precios de 2025", size(small)) ytitle("Densidad") legend(order(1 "No usa" 2 "Usa") rows(1) size(small)) graphr
> egion(color(white)) plotregion(color(white)) name(e8_dens_informal, replace)

. graph combine e8_dens_formal e8_dens_informal, cols(2) xcommon ycommon title("Distribucion del ingreso y uso de computadora", size(med
> small)) note("Calculos descriptivos sin ponderadores ni controles. Se utilizan las 18 065 observaciones." "Kernel gaussiano y ancho co
> mun; las curvas resumen la distribucion completa.", size(vsmall)) graphregion(color(white)) xsize(12) ysize(6) name(e8_densidades, rep
> lace)

. graph export "`resultados'/03_Distribuciones_ingreso_TIC.png", width(3200) replace
file $ENAHO_SALIDA/Complemento_MCO_etapa08E/03_Distribuciones_ingreso_TIC.png saved as PNG
    format

. graph save "`resultados'/03_Distribuciones_ingreso_TIC.gph", replace
file $ENAHO_SALIDA/Complemento_MCO_etapa08E/03_Distribuciones_ingreso_TIC.gph saved

. preserve

. keep e8_grid e8_f0 e8_f1 e8_i0 e8_i1 e8_ancho

. keep if !missing(e8_grid)
(17,665 observations deleted)

. assert _N == 400

. save "`resultados'/densidades_tic.dta", replace
file $ENAHO_SALIDA/Complemento_MCO_etapa08E/densidades_tic.dta saved

. export delimited using "`resultados'/densidades_tic.csv", replace
file $ENAHO_SALIDA/Complemento_MCO_etapa08E/densidades_tic.csv saved

. restore

