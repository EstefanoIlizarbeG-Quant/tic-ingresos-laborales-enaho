. * 7. ASOCIACIONES: DOS PANELES CON IC DEL 95%, MODELO LINEAL.
. preserve

. use "`resultados'/asociaciones_tipo.dta", clear

. keep if modelo == "Lineal"
(16 observations deleted)

. assert _N == 8

. generate double e8_x = tipo + cond(informalidad == 0, -0.09, 0.09)

. local lienzo "graphregion(color(white)) plotregion(color(white))"

. foreach margen in Uso Intensidad {
  2.     local titulo "Uso de computadora"
  3.     if "`margen'" == "Intensidad" local titulo "Actividad adicional entre usuarios"
  4.     twoway (rcap pct_li pct_ls e8_x if margen == "`margen'" & informalidad == 0, lcolor(navy)) (scatter pct e8_x if
>  margen == "`margen'" & informalidad == 0, mcolor(navy) msymbol(O)) (rcap pct_li pct_ls e8_x if margen == "`margen'" &
>  informalidad == 1, lcolor(maroon)) (scatter pct e8_x if margen == "`margen'" & informalidad == 1, mcolor(maroon) msym
> bol(D)), title("`titulo'", size(medsmall)) xtitle("") xlabel(1 "Dependientes" 2 "Empl./indep.", labsize(small)) xscale
> (range(0.65 2.35)) ytitle("Diferencia porcentual condicional", size(small)) yline(0, lcolor(gs10)) legend(order(2 "For
> males" 4 "Informales") rows(1) size(small)) `lienzo' name(e8_`margen', replace)
  5. }

. graph combine e8_Uso e8_Intensidad, cols(2) title("Asociaciones TIC por tipo de trabajador", size(medsmall)) note("IC 
> individuales del 95%. Muestra: 18 065; 772 conglomerados del marco." "Uso: usuario frente a no usuario, a la intensida
> d de referencia." "Intensidad: una actividad adicional entre usuarios. Centro fijo: 6.254633 actividades.", size(vsmal
> l)) graphregion(color(white)) xsize(12) ysize(6) name(e8_asociaciones, replace)

. graph export "`resultados'/01_Asociaciones_TIC_por_tipo.png", width(3200) replace
file $ENAHO_SALIDA/Complemento_MCO_etapa08E/01_Asociaciones_TIC_por_tipo.png saved as PNG
    format

