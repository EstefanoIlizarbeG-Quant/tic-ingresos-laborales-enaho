> rabajador", size(medsmall)) xtitle("Coeficiente de empleadores/independientes menos dependientes", size(small)) ytitle("") ylabel(1 "U
> so: formales" 2 "Uso: informales" 3 "Actividad: formales" 4 "Actividad: informales", angle(0) labsize(small)) yscale(reverse) xline(0,
>  lcolor(maroon)) legend(off) note("Diferencias en log puntos. IC individuales del 95%; VCE agrupada por marco." "Los p originales y aj
> ustados por Holm se reportan en diferencias_tipo.dta.", size(vsmall)) graphregion(color(white)) plotregion(color(white)) xsize(10) ysi
