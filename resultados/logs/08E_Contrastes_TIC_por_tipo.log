. 
. * 4. VERIFICAR LA EQUIVALENCIA DE LOS AJUSTES CON REGRESIONES SEPARADAS.
. * Se comparan predicciones, no se exige igualdad de sus VCE finitas.
. estimates restore E8_Lineal
(results E8_Lineal are active now)

. predict double e8_ajuste_conjunto, xb

. generate double e8_ajuste_separado = .
(18,065 missing values generated)

. forvalues tipo = 1/2 {
  2.     quietly regress ln_ing_hora_real2025 `controles' `tic_base' if tipo_trabajador == `tipo', vce(cluster id_conglo
> merado_marco)
  3.     predict double e8_ajuste_temporal if tipo_trabajador == `tipo', xb
  4.     replace e8_ajuste_separado = e8_ajuste_temporal if tipo_trabajador == `tipo'
  5.     drop e8_ajuste_temporal
  6. }
(5,845 missing values generated)
(12,220 real changes made)
(12,220 missing values generated)
(5,845 real changes made)

. assert abs(e8_ajuste_conjunto - e8_ajuste_separado) < 1e-6

. display "VERIFICACION: ajustes conjuntos y separados coinciden."
VERIFICACION: ajustes conjuntos y separados coinciden.

. estimates restore E8_Lineal
(results E8_Lineal are active now)

. 
. * 5. AJUSTE HOLM DE CUATRO CONTRASTES POR ESPECIFICACION.
. preserve

. use "`resultados'/diferencias_tipo.dta", clear

. assert !missing(p, b, se, li, ls)

. bysort modelo: assert _N == 4

. bysort modelo (p orden): generate double p_holm = min(1, (_N - _n + 1)*p)

. by modelo: replace p_holm = max(p_holm, p_holm[_n-1]) if _n > 1
(0 real changes made)

. assert p_holm >= p - 1e-12

. assert inrange(p_holm, 0, 1)

. label variable p_holm "Holm: cuatro comparaciones individuales por especificacion"

. sort modelo orden

. save "`resultados'/diferencias_tipo.dta", replace
file $ENAHO_SALIDA/Complemento_MCO_etapa08E/diferencias_tipo.dta saved

. restore

. 
. * 6. EXPORTAR TABLAS NUMERICAS PARA EL WORD.
. foreach tabla in coeficientes_tipo asociaciones_tipo diferencias_tipo pruebas_tipo resumen_modelos_tipo {
  2.     preserve
  3.     use "`resultados'/`tabla'.dta", clear
  4.     export delimited using "`resultados'/`tabla'.csv", replace
  5.     if "`tabla'" == "asociaciones_tipo" {
  6.         format b se pct pct_li pct_ls %10.5f
  7.         format p %12.5g
  8.         list modelo tipo informalidad margen b se p pct pct_li pct_ls, sepby(modelo) noobs
  9.     }
 10.     if "`tabla'" == "diferencias_tipo" {
 11.         format b se li ls %10.5f
 12.         format p p_holm %12.5g
 13.         list modelo margen informalidad b se li ls p p_holm, sepby(modelo) noobs
 14.     }
 15.     if "`tabla'" == "pruebas_tipo" {
 16.         format F %10.5f
 17.         format p %12.5g
 18.         list, sepby(modelo) noobs
 19.     }
 20.     if "`tabla'" == "resumen_modelos_tipo" list, noobs
 21.     restore
 22. }
