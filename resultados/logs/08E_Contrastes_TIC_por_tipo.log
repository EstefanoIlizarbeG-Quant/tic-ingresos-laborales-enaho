.     * Coeficientes: IC t de Stata con los grados de libertad agrupados.
.     tempname B V bb ss pp ll uu crit
 20.     matrix `B' = e(b)
 21.     matrix `V' = e(V)
 22.     local terminos : colnames `B'
 23.     scalar `crit' = invttail(e(df_r), 0.025)
 24.     forvalues j = 1/`=colsof(`B')' {
 25.         local termino : word `j' of `terminos'
 26.         scalar `bb' = `B'[1, `j']
 27.         scalar `ss' = sqrt(`V'[`j', `j'])
 28.         if `ss' > 0 & !missing(`ss') {
 29.             scalar `pp' = 2 * ttail(e(df_r), abs(`bb'/`ss'))
 30.             scalar `ll' = `bb' - `crit' * `ss'
 31.             scalar `uu' = `bb' + `crit' * `ss'
 32.             post `HC' ("`modelo'") ("`termino'") (`bb') (`ss') (`pp') (`ll') (`uu') (e(N)) (e(N_clust))
 33.         }
 34.     }
