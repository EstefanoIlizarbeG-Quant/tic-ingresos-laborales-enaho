 67.         twoway (scatter residuo_parcial educ_years, mcolor(navy) msize(small)) (line componente educ_years, lcolor(
> maroon)), title("`modelo': componente educativo") xtitle("Anios de educacion") ytitle("Componente educativo y residuo 
> parcial") legend(order(1 "Media de residuos parciales" 2 "Componente estimado")) note("Media por anios observados. Dia
> gnostico de forma funcional.") name(ec_graf, replace)
 68.         graph export "`resultados'/educacion_`modelo'.png", width(2000) replace
 69.         graph save ec_graf "`resultados'/educacion_`modelo'.gph", replace
 70.         restore
 71. 
.         * RESET posterior a cada forma: se reporta, no se usa como
.         * criterio automatico para seleccionar la especificacion.
.         quietly summarize `ajuste'
 72.         tempvar z r2 r3 r4
 73.         generate double `z' = (`ajuste' - r(mean)) / r(sd)
 74.         generate double `r2' = `z'^2
 75.         generate double `r3' = `z'^3
 76.         generate double `r4' = `z'^4
