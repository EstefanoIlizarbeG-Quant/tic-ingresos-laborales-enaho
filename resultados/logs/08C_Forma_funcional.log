 37.             test 1.tic_uso_pc#1.informal 1.informal#c.actividades_centradas
 38.             post `HT' ("`modelo'") ("Interacciones TIC e informalidad") (r(F)) (r(df)) (r(df_r)) (r(p)) (e(N)) (e(r
> 2)) (e(N_clust))
 39.         }
 40. 
.         * Cambio discreto de un anio de educacion, manteniendo los
.         * demas regresores constantes: f(E+1)-f(E), no solo f'(E).
.         foreach e in 5 10 15 18 {
 41.             local expresion "educ_years"
 42.             local hasta = `e' + 1
 43.             if "`forma'" == "Cuadratica" {
 44.                 local multiplicador = 2*`e' + 1
 45.                 local expresion "educ_years + `multiplicador'*c.educ_years#c.educ_years"
 46.             }
 47.             if "`forma'" == "Tramos" {
 48.                 foreach nudo in 6 11 16 {
 49.                     local delta = max(`hasta'-`nudo', 0) - max(`e'-`nudo', 0)
 50.                     if `delta' != 0 local expresion "`expresion' + `delta'*e_h`nudo'"
 51.                 }
 52.             }
 53.             lincom `expresion'
 54.             post `HE' ("`modelo'") (`e') (`hasta') (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (100*(exp(r(estimat
> e))-1)) (100*(exp(r(lb))-1)) (100*(exp(r(ub))-1))
 55.         }
