. capture program drop ec08_coef

. program define ec08_coef
  1.     args handle modelo
  2.     tempname B V bb ss pp li ls crit
  3.     matrix `B' = e(b)
  4.     matrix `V' = e(V)
  5.     local terminos : colnames `B'
  6.     local k = colsof(`B')
  7.     scalar `crit' = invttail(e(df_r), 0.025)
  8.     forvalues j = 1/`k' {
  9.         local termino : word `j' of `terminos'
 10.         scalar `bb' = `B'[1, `j']
 11.         scalar `ss' = sqrt(`V'[`j', `j'])
 12.         if `ss' > 0 & !missing(`ss') {
 13.             scalar `pp' = 2 * ttail(e(df_r), abs(`bb' / `ss'))
 14.             scalar `li' = `bb' - `crit' * `ss'
 15.             scalar `ls' = `bb' + `crit' * `ss'
 16.             post `handle' ("`modelo'") ("`termino'") (`bb') (`ss') (`pp') (`li') (`ls') (e(N)) (e(r2)) (e(N_clust))
 17.         }
 18.     }
 19. end

. 
. foreach familia in M1 M2 {
  2.     foreach forma in Lineal Cuadratica Tramos {
  3.         local modelo "`familia'_`forma'"
  4.         local formula "`mincer'"
