 78.         test `r2' `r3' `r4'
 79.         post `HT' ("`modelo'") ("RESET: potencias del ajuste") (r(F)) (r(df)) (r(df_r)) (r(p)) (e(N)) (`r2_base') (
> e(N_clust))
 80.         drop `residuo' `ajuste' `componente' `parcial' `z' `r2' `r3' `r4'
 81.     }
