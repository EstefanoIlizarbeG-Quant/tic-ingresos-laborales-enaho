. 
. * 5. NUEVE ESPECIFICACIONES PREDEFINIDAS Y SU MCO COMPARABLE.
. * Ambas: ambas candidatas en Z y ninguna en W.
. * Menores / NoLaboral: cada candidata por separado en Z.
. * NoLabEnY / MenorEnY: permitir relacion directa de una candidata con Y;
. * la otra queda excluida de la ecuacion de resultado.
. * Cuadratica: educacion cuadratica en W y Z.
. * Estado: retirar del dominio de estimacion la situacion laboral indefinida.
. * Ponderado: fac500a positivo; misma muestra; sensibilidad de estimando y VCE.
. * SinProductivas: omitir sector y ocupacion manteniendo la muestra fija.
. 
. local principal_ok = 0

. local fallidos = 0

. foreach nombre in Ambas Menores NoLaboral NoLabEnY MenorEnY Cuadratica Estado Ponderado SinProductivas {
  2.     local W "`W_base'"
  3.     local Z "`Z_base' `candidatas'"
  4.     local excluidos "1.hay_menor6 ln_nolaboral_real2025"
  5.     local muestra "h10_mincer"
  6.     local pesos ""
  7.     local ponderado = 0
  8.     if "`nombre'" == "Menores" {
  9.         local Z "`Z_base' ib0.hay_menor6"
 10.         local excluidos "1.hay_menor6"
 11.     }
 12.     if "`nombre'" == "NoLaboral" {
 13.         local Z "`Z_base' c.ln_nolaboral_real2025"
 14.         local excluidos "ln_nolaboral_real2025"
 15.     }
 16.     if "`nombre'" == "NoLabEnY" {
 17.         local W "`W_base' c.ln_nolaboral_real2025"
 18.         local excluidos "1.hay_menor6"
 19.     }
 20.     if "`nombre'" == "MenorEnY" {
 21.         local W "`W_base' ib0.hay_menor6"
 22.         local excluidos "ln_nolaboral_real2025"
 23.     }
 24.     if "`nombre'" == "Cuadratica" {
 25.         local W "`W_base' c.h10_educ2"
 26.         local Z "`Z_base' c.h10_educ2 `candidatas'"
 27.     }
 28.     if "`nombre'" == "Estado" local muestra "h10_estado"
 29.     if "`nombre'" == "Ponderado" {
 30.         local pesos "[pweight=fac500a]"
 31.         local ponderado = 1
 32.     }
 33.     if "`nombre'" == "SinProductivas" local W "`personales' `temporales'"
 34. 
.     quietly count if `muestra' == 1
 35.     local nt = r(N)
 36.     quietly count if `muestra' == 1 & S_ingreso == 1
 37.     local ns = r(N)
 38.     local nn = `nt' - `ns'
 39.     display _newline "ESPECIFICACION: `nombre'"
 40.     display "W: `W'"
 41.     display "Z: `Z'"
 42.     display "CANDIDATAS EXCLUIDAS DE W: `excluidos'"
 43.     display "Muestra total: `nt'; seleccionados: `ns'; no seleccionados: `nn'."
 44. 
.     * MCO usa exactamente los seleccionados que debera conservar Heckman.
.     regress ln_ing_hora_real2025 `W' if `muestra' == 1 & S_ingreso == 1 `pesos', vce(cluster id_conglomerado_marco)
 45.     assert e(N) == `ns'
