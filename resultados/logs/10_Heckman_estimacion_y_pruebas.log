 99.         post `HT' ("H_`nombre'") ("Ingreso no laboral en resultado") ("Wald") (r(chi2)) (r(df)) (.) (r(p)) (0)
100.     }
101.     if "`nombre'" == "MenorEnY" {
102.         test [ln_ing_hora_real2025]1.hay_menor6
103.         post `HT' ("H_`nombre'") ("Menores en resultado") ("Wald") (r(chi2)) (r(df)) (.) (r(p)) (0)
104.     }
105. 
.     * Rho/sigma: IC transformando los IC de sus parametros no acotados.
.     * Kappa=rho*sigma: IC delta. Kappa multiplica la razon de Mills;
.     * la razon de Mills y su coeficiente son magnitudes diferentes.
.     tempname a s cr rho_b rho_se rho_li rho_ls sig_b sig_se sig_li sig_ls KP
106.     scalar `a' = _b[/athrho]
107.     scalar `s' = _b[/lnsigma]
108.     scalar `cr' = invnormal(0.975)
109.     scalar `rho_b' = tanh(`a')
110.     scalar `rho_se' = (1 - tanh(`a')^2) * _se[/athrho]
111.     scalar `rho_li' = tanh(`a' - `cr' * _se[/athrho])
112.     scalar `rho_ls' = tanh(`a' + `cr' * _se[/athrho])
113.     scalar `sig_b' = exp(`s')
114.     scalar `sig_se' = exp(`s') * _se[/lnsigma]
115.     scalar `sig_li' = exp(`s' - `cr' * _se[/lnsigma])
116.     scalar `sig_ls' = exp(`s' + `cr' * _se[/lnsigma])
117.     post `HP' ("H_`nombre'") ("rho") ("Transformacion_atanh") (`rho_b') (`rho_se') (`p_rho') (`rho_li') (`rho_ls')
118.     post `HP' ("H_`nombre'") ("sigma") ("Transformacion_log") (`sig_b') (`sig_se') (.) (`sig_li') (`sig_ls')
119.     nlcom (kappa: tanh(_b[/athrho]) * exp(_b[/lnsigma]))
120.     matrix `KP' = r(table)
121.     post `HP' ("H_`nombre'") ("kappa") ("Delta") (`KP'[1,1]) (`KP'[2,1]) (`KP'[4,1]) (`KP'[5,1]) (`KP'[6,1])
122.     if abs(e(rho)) >= 0.98 {
123.         display as error "REVISAR: |rho| >= 0.98 en H_`nombre'. Convergencia no acredita estabilidad."
124.     }
125. }

