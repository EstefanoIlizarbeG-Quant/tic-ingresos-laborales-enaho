. * 7. EXPORTAR Y MOSTRAR LOS RESULTADOS. CSV conserva los numeros sin redondear.
. foreach nombre in coeficientes_heckman pruebas_heckman resumen_modelos_heckman parametros_heckman {
  2.     preserve
  3.     use "`resultados'/`nombre'.dta", clear
  4.     if "`nombre'" == "resumen_modelos_heckman" {
  5.         generate byte alerta_rho = abs(rho) >= 0.98 if metodo == "Heckman" & !missing(rho)
  6.         label variable alerta_rho "Diagnostico: |rho| >= 0.98; revisar estabilidad"
  7.         save "`resultados'/`nombre'.dta", replace
  8.         format rho sigma kappa %10.5f
  9.         list modelo metodo ponderado rc N N_selec N_no_selec grupos convergencia alerta_rho rho sigma kappa, sepby(
> metodo) noobs
 10.     }
 11.     if "`nombre'" == "pruebas_heckman" {
 12.         format estadistico p %12.6f
 13.         list, sepby(modelo) noobs
 14.     }
 15.     if "`nombre'" == "parametros_heckman" {
 16.         format b se p li ls %12.6f
 17.         list, sepby(modelo) noobs
 18.     }
 19.     export delimited using "`resultados'/`nombre'.csv", replace
 20.     restore
 21. }
