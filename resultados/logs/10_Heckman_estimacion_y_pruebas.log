. capture program drop h10_coef

. program define h10_coef
  1.     args handle modelo metodo
  2.     tempname B V bb ss pp ll uu crit df
  3.     matrix `B' = e(b)
  4.     matrix `V' = e(V)
  5.     local terminos : colnames `B'
  6.     local ecuaciones : coleq `B'
  7.     scalar `crit' = invnormal(0.975)
  8.     if "`metodo'" == "MCO" {
  9.         scalar `df' = e(df_r)
 10.         scalar `crit' = invttail(`df', 0.025)
 11.     }
 12.     forvalues j = 1/`=colsof(`B')' {
 13.         local termino : word `j' of `terminos'
 14.         local ecuacion : word `j' of `ecuaciones'
 15.         scalar `bb' = `B'[1, `j']
 16.         scalar `ss' = sqrt(`V'[`j', `j'])
 17.         if `ss' > 0 & !missing(`ss') {
 18.             scalar `pp' = 2 * normal(-abs(`bb' / `ss'))
 19.             if "`metodo'" == "MCO" scalar `pp' = 2 * ttail(`df', abs(`bb' / `ss'))
 20.             scalar `ll' = `bb' - `crit' * `ss'
 21.             scalar `uu' = `bb' + `crit' * `ss'
 22.             post `handle' ("`modelo'") ("`metodo'") ("`ecuacion'") ("`termino'") (`bb') (`ss') (`pp') (`ll') (`uu')
>  (e(N)) (e(N_clust))
 23.         }
 24.     }
 25. end

