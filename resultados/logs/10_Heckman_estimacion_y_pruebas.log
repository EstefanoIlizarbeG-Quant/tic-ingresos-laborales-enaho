 54.         post `HT' ("O_`nombre'") ("Educacion cuadratica en MCO") ("F") (r(F)) (r(df)) (r(df_r)) (r(p)) (0)
 55.     }
 56. 
.     capture noisily heckman ln_ing_hora_real2025 `W' if `muestra' == 1 `pesos', select(S_ingreso = `Z') vce(cluster id
> _conglomerado_marco) difficult iterate(200)
 57.     local rc = _rc
 58.     if `rc' != 0 {
 59.         post `HM' ("H_`nombre'") ("Heckman") (`ponderado') (`rc') (`nt') (`ns') (`nn') (772) (0) (.) (.) (.) (.) (.
> ) (.)
 60.         display as error "H_`nombre' devolvio r(`rc'). Se registra y se conserva el MCO comparable."
 61.         local fallidos = `fallidos' + 1
 62.         continue
 63.     }
