. * 8. GRAFICO DE COEFICIENTES CON IC: MCO Y HECKMAN, MISMA MUESTRA.
. * No es un contraste formal de igualdad entre estimadores.
. if `principal_ok' == 1 {
.     preserve
.     use "`resultados'/coeficientes_heckman.dta", clear
.     keep if inlist(modelo, "O_Ambas", "H_Ambas")
(833 observations deleted)
.     keep if metodo == "MCO" | (metodo == "Heckman" & ecuacion == "ln_ing_hora_real2025")
(24 observations deleted)
.     generate byte h10_orden = .
(76 missing values generated)
.     replace h10_orden = 5 if termino == "educ_years"
(2 real changes made)
.     replace h10_orden = 4 if termino == "experiencia_potencial"
(2 real changes made)
.     replace h10_orden = 3 if termino == "1.mujer"
(2 real changes made)
.     replace h10_orden = 2 if termino == "1.casado"
(2 real changes made)
.     replace h10_orden = 1 if termino == "1.jefe_hogar"
(2 real changes made)
.     keep if !missing(h10_orden)
(66 observations deleted)
.     assert _N == 10
.     generate double h10_posicion = h10_orden + cond(metodo == "MCO", 0.12, -0.12)
.     twoway (rcap li ls h10_posicion if metodo == "MCO", horizontal lcolor(navy)) (scatter h10_posicion b if metodo == 
> "MCO", mcolor(navy) msymbol(O)) (rcap li ls h10_posicion if metodo == "Heckman", horizontal lcolor(maroon)) (scatter h
> 10_posicion b if metodo == "Heckman", mcolor(maroon) msymbol(D)), title("Mincer: MCO y Heckman") xtitle("Coeficiente e
>  intervalo del 95% en log ingreso") ytitle("") ylabel(1 "Jefe del hogar" 2 "Casado" 3 "Mujer" 4 "Experiencia potencial
> " 5 "Educacion", angle(0)) xline(0, lcolor(gs10)) legend(order(2 "MCO" 4 "Heckman") rows(1)) note("Ambos modelos: mism
> os 18 069 seleccionados y controles." "Inferencia agrupada por 772 conglomerados del marco.") graphregion(color(white)
> ) name(h10_compara, replace)
.     graph export "`resultados'/03_Coeficientes_MCO_Heckman.png", width(3200) replace
