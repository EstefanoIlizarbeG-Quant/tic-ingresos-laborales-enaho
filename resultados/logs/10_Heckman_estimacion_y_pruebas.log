> st)) (0) (e(rank)) (e(ll)) (.) (e(rho)) (e(sigma)) (e(lambda))
 67.         display as error "H_`nombre' no convergio: queda registrado como no utilizable."
 68.         local fallidos = `fallidos' + 1
 69.         continue
 70.     }
 71.     assert e(N) == `nt'
 72.     assert e(N_selected) == `ns'
 73.     assert e(N_nonselected) == `nn'
 74.     assert e(N_clust) == 772
 75.     assert e(sample) == (`muestra' == 1)
 76.     generate byte h10_es_`nombre' = e(sample)
 77.     estimates store H_`nombre'
