  4.     quietly count if e(sample) & S_ingreso == 0
  5.     local nn = r(N)
  6.     local cv = 1
  7.     local rr = .
  8.     local rh = .
  9.     local sg = .
 10.     local kp = .
 11.     if "`metodo'" == "MCO" local rr = e(r2)
 12.     if inlist("`metodo'", "Probit", "Heckman") local cv = e(converged)
 13.     if "`metodo'" == "Heckman" {
 14.         local rh = e(rho)
 15.         local sg = e(sigma)
 16.         local kp = e(lambda)
 17.     }
 18.     post `handle' ("`modelo'") ("`metodo'") (`ponderado') (0) (e(N)) (`ns') (`nn') (e(N_clust)) (`cv') (e(rank)) (e
> (ll)) (`rr') (`rh') (`sg') (`kp')
 19. end

