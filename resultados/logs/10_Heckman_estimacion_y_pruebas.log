 81.     if "`nombre'" == "Ambas" local principal_ok = 1
 82. 
.     * Wald de independencia: atanh(rho)=0 equivale a rho=0.
.     * Su VCE es la misma VCE agrupada de la estimacion. No usar lrtest.
.     test _b[/athrho] = 0
 83.     local p_rho = r(p)
 84.     post `HT' ("H_`nombre'") ("Independencia de ecuaciones: rho=0") ("Wald") (r(chi2)) (r(df)) (.) (r(p)) (0)
 85. 
.     * Relevancia en seleccion de las candidatas excluidas de W.
.     local restricciones ""
 86.     foreach variable of local excluidos {
 87.         local restricciones "`restricciones' ([S_ingreso]`variable' = 0)"
 88.     }
 89.     test `restricciones'
 90.     post `HT' ("H_`nombre'") ("Candidatas excluidas: relevancia en seleccion") ("Wald") (r(chi2)) (r(df)) (.) (r(p)
> ) (0)
 91. 
.     if "`nombre'" == "Cuadratica" {
 92.         test [ln_ing_hora_real2025]h10_educ2
 93.         post `HT' ("H_`nombre'") ("Educacion cuadratica en resultado") ("Wald") (r(chi2)) (r(df)) (.) (r(p)) (0)
 94.         test [S_ingreso]h10_educ2
 95.         post `HT' ("H_`nombre'") ("Educacion cuadratica en seleccion") ("Wald") (r(chi2)) (r(df)) (.) (r(p)) (0)
 96.     }
