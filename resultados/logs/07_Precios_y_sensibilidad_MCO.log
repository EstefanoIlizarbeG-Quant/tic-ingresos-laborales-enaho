 26.     }
 27.     if "`modelo'" == "P201P_Real" {
 28.         local cluster "id_persona_p201p"
 29.         local inferencia "Cluster P201P"
 30.     }
 31.     if "`modelo'" == "Hogar_Real" {
 32.         local cluster "id_hogar_marco"
 33.         local inferencia "Cluster hogar"
 34.     }
 35.     if "`modelo'" == "R_TIC8" {
 36.         local x "`personales' `productivos' `temporales' `tic8'"
 37.         local act "actividades8_centradas"
 38.         local centro = `media8'
 39.     }
 40. 
.     display _newline "MODELO: `modelo'"
 41.     display "Dependiente: `y'; inferencia: `inferencia'"
 42.     quietly count if `condicion'
 43.     local n_esperado = r(N)
 44.     regress `y' `x' if `condicion' `pesos', vce(cluster `cluster') level(95)
 45.     assert e(N) == `n_esperado'
 46.     estimates store `modelo'
 47.     estimates save "`resultados'/`modelo'.ster", replace
 48.     if "`modelo'" == "M2_Real" generate byte muestra_principal07 = e(sample)
 49. 
.     matrix `B' = e(b)
 50.     matrix `V' = e(V)
 51.     local nombres : colnames `B'
 52.     local j = 0
 53.     foreach termino of local nombres {
 54.         local j = `j' + 1
 55.         local b = el(`B', 1, `j')
 56.         local se = sqrt(el(`V', `j', `j'))
 57.         local p = .
 58.         local li = .
 59.         local ls = .
 60.         if `se' > 0 & `se' < . {
 61.             local p = 2 * ttail(e(df_r), abs(`b' / `se'))
 62.             local critico = invttail(e(df_r), 0.025)
 63.             local li = `b' - `critico' * `se'
 64.             local ls = `b' + `critico' * `se'
 65.         }
 66.         post `HC' ("`modelo'") ("`termino'") ("`inferencia'") (`b') (`se') (`p') (`li') (`ls') (e(N)) (e(r2)) (e(N_clust))
 67.     }
 68. 
.     if !inlist("`modelo'", "M1_Real", "I1_Real", "I2_Real") {
 69.         test (1.tic_uso_pc = 0) (`act' = 0)
 70.         post `HT' ("`modelo'") ("TIC entre formales") (r(F)) (r(df)) (r(df_r)) (r(p)) (e(N))
 71.         test (1.tic_uso_pc#1.informal = 0) (1.informal#c.`act' = 0)
 72.         post `HT' ("`modelo'") ("Heterogeneidad por informalidad") (r(F)) (r(df)) (r(df_r)) (r(p)) (e(N))
 73.         test (1.tic_uso_pc = 0) (`act' = 0) (1.tic_uso_pc#1.informal = 0) (1.informal#c.`act' = 0)
 74.         post `HT' ("`modelo'") ("Bloque TIC completo") (r(F)) (r(df)) (r(df_r)) (r(p)) (e(N))
 75. 
.         lincom 1.tic_uso_pc + 1.tic_uso_pc#1.informal
 76.         post `HX' ("`modelo'") ("U entre informales, intensidad de referencia") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N))
 77.         lincom `act' + 1.informal#c.`act'
 78.         post `HX' ("`modelo'") ("Actividad adicional entre informales") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N))
 79.         lincom 1.informal + 1.tic_uso_pc#1.informal
 80.         post `HX' ("`modelo'") ("Brecha informal-formal entre usuarios") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N))
 81.         lincom 1.informal + 1.tic_uso_pc + 1.tic_uso_pc#1.informal
 82.         post `HX' ("`modelo'") ("Usuario informal vs no usuario formal") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N))
 83. 
.         * Usuarios con cero actividades: referencia observable comun.
.         lincom 1.tic_uso_pc - `centro' * `act'
 84.         post `HX' ("`modelo'") ("Usuario formal cero act. vs no usuario formal") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)
> )
 85.         lincom 1.tic_uso_pc + 1.tic_uso_pc#1.informal - `centro' * (`act' + 1.informal#c.`act')
 86.         post `HX' ("`modelo'") ("Usuario informal cero act. vs no usuario informal") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (
> e(N))
 87.     }
 88. }

